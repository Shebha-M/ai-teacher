# ==============================================================================
# AI TEACHER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running in production or with live cloud APIs.
# Defaults are already configured for zero-setup local deterministic execution.

# --- Application Settings ---
PROJECT_NAME="AI Teacher Backend"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# --- Database Configuration ---
# Uses SQLite in WAL mode by default; switch to PostgreSQL in production:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/ai_teacher"
DATABASE_URL="sqlite+aiosqlite:///./ai_teacher.db"

# --- AI & LLM Providers ---
# Leave GEMINI_API_KEY empty to run locally using the high-fidelity Deterministic Provider (no API key needed)
GEMINI_API_KEY=""
DEFAULT_LLM_MODEL="gemini-1.5-flash"

# Optional secondary cloud providers
OPENAI_API_KEY=""

# --- Media & Video Providers (Roadmap for Phase 3 & 4) ---
# ELEVENLABS_API_KEY=""
# HEYGEN_API_KEY=""
# DID_API_KEY=""

# --- CORS Origins (JSON list or comma-separated) ---
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
